# Server Port
PORT=3000

# ElevenLabs API Key (For Instant Voice Cloning & Multilingual Dubbing: Chinese -> Khmer)
# Get from https://elevenlabs.io
ELEVENLABS_API_KEY=

# Google Gemini API Key (Optional: for cinematic subtitle translation & character analysis)
# Get from https://aistudio.google.com
GEMINI_API_KEY=

# Skip the login screen & premium tiers entirely (recommended for personal/local
# use — every request is treated as an already-logged-in admin with full
# access to every feature). Set to false to restore normal multi-user login.
DISABLE_LOGIN=true
